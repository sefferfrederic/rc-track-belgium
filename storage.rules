rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Photo de profil: chacun peut lire, seul le propriétaire peut écrire la sienne
    match /avatars/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Photos de pistes / événements: lecture publique, écriture réservée à l'admin
    // (vérification du rôle admin faite côté Cloud Function avant génération de l'URL d'upload,
    // ou via une règle Firestore-backed si besoin plus strict)
    match /tracks/{trackId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /events/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Photos de voitures (Mon Garage) : lecture publique (nécessaire pour les réglages
    // partagés publiquement), écriture réservée au propriétaire du dossier (son propre uid).
    match /cars/{uid}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Photos d'annonces (module Vente) : lecture publique, écriture réservée au
    // vendeur (son propre uid). Supprimées automatiquement avec l'annonce après 30 jours.
    match /listings/{uid}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
  }
}
