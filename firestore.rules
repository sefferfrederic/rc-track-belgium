rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    // --- Utilisateurs ---
    // Chacun lit tous les profils (nécessaire pour afficher pseudo/photo dans sessions, chat, notifs)
    // mais ne peut modifier que le sien. Le champ "role" ne peut être changé que par un admin.
    match /users/{uid} {
      allow read: if isSignedIn();
      allow create: if isOwner(uid) && request.resource.data.role == "user";
      allow update: if isOwner(uid) &&
        (!("role" in request.resource.data) || request.resource.data.role == resource.data.role) ||
        isAdmin();
      allow delete: if isAdmin();
    }

    // --- Taxonomies dynamiques (disciplines / surfaces / échelles) ---
    // Lecture libre, écriture réservée à l'admin.
    match /taxonomies/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- Pistes ---
    match /tracks/{trackId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- Sessions de roulage ---
    // Tout utilisateur connecté peut créer/rejoindre. Il ne peut modifier/retirer
    // que sa propre entrée dans le tableau "participants" (validé côté Cloud Function
    // pour le regroupement — voir docs/architecture.md).
    match /sessions/{sessionId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();

      match /chat/{messageId} {
        allow read: if isSignedIn() &&
          request.auth.uid in get(/databases/$(database)/documents/sessions/$(sessionId)).data.participantUids;
        allow create: if isSignedIn() &&
          request.resource.data.authorUid == request.auth.uid &&
          request.auth.uid in get(/databases/$(database)/documents/sessions/$(sessionId)).data.participantUids;
        allow update: if isAdmin();
        // Un participant peut supprimer un message, mais UNIQUEMENT s'il est déjà expiré
        // (nettoyage automatique 48h, déclenché à l'ouverture du chat — voir lib/firebase/chat.ts)
        allow delete: if isAdmin() ||
          (isSignedIn() &&
            request.auth.uid in get(/databases/$(database)/documents/sessions/$(sessionId)).data.participantUids &&
            resource.data.expiresAt <= request.time.toMillis());
      }
    }

    // --- Mon Garage : voitures ---
    // Une voiture n'appartient qu'à son propriétaire ; personne d'autre ne peut la lire
    // (les réglages "publics" sont dénormalisés avec leur propre nom de voiture, donc
    // pas besoin de lire le document voiture pour les afficher publiquement).
    match /cars/{carId} {
      allow read: if isSignedIn() && (resource.data.ownerUid == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if isSignedIn() && (resource.data.ownerUid == request.auth.uid || isAdmin());

      // --- Fiches de réglages ---
      // Visibles par leur auteur toujours, et par tout le monde si marquées publiques.
      // Seul le propriétaire de LA VOITURE peut y ajouter/modifier des réglages
      // (empêche un tiers d'écrire dans le garage de quelqu'un d'autre).
      match /setups/{setupId} {
        allow create: if isSignedIn() &&
          request.resource.data.authorUid == request.auth.uid &&
          get(/databases/$(database)/documents/cars/$(carId)).data.ownerUid == request.auth.uid;
        allow update, delete: if isSignedIn() && (resource.data.authorUid == request.auth.uid || isAdmin());
      }
    }

    // --- Lecture des réglages via requête groupée (page "Réglages publics") ---
    // Syntaxe spécifique requise par Firestore pour les requêtes "collectionGroup".
    match /{path=**}/setups/{setupId} {
      allow read: if true;
    }

    // --- Événements ---
    match /events/{eventId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      // L'admin peut tout modifier ; un utilisateur connecté ne peut modifier
      // que sa participation ("going"/"interested"), pas le contenu de l'événement.
      allow update: if isAdmin() ||
        (isSignedIn() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(["going", "interested"]));
    }

    // --- Communication (bannière admin) ---
    // Lecture libre (y compris utilisateurs déconnectés), écriture réservée à l'admin.
    match /announcements/{announcementId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- Vente entre pilotes ---
    // Lecture publique (favorise la découverte, attire de nouveaux visiteurs).
    // La suppression automatique après 30 jours est gérée par la tâche planifiée
    // /api/cleanup-listings (voir vercel.json), pas par ces règles.
    match /listings/{listingId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.sellerUid == request.auth.uid;
      allow update, delete: if isSignedIn() && (resource.data.sellerUid == request.auth.uid || isAdmin());
    }

    // --- Conversations privées acheteur/vendeur (module Vente) ---
    match /conversations/{conversationId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.participantUids;
      allow create: if isSignedIn() && request.auth.uid in request.resource.data.participantUids;
      allow update: if isSignedIn() && request.auth.uid in resource.data.participantUids;

      match /messages/{messageId} {
        allow read: if isSignedIn() &&
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantUids;
        allow create: if isSignedIn() &&
          request.resource.data.authorUid == request.auth.uid &&
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantUids;
      }
    }

    // --- Notifications ---
    // Un utilisateur ne voit et ne modifie (marquer comme lu) que ses propres notifications.
    // La création se fait uniquement côté serveur (Cloud Functions).
    match /notifications/{notifId} {
      allow read: if isOwner(resource.data.toUid);
      allow update: if isOwner(resource.data.toUid) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(["read"]);
      allow create, delete: if false; // réservé aux Cloud Functions (Admin SDK)
    }
  }
}
