# Copie ce fichier en ".env.local" et remplis les valeurs
# Tu les trouves dans la Console Firebase > Paramètres du projet > Général > "Vos applications"
# Voir docs/firebase-setup-guide.md pour le pas-à-pas complet

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Notifications push (Firebase Cloud Messaging)
# Console Firebase > Paramètres du projet > Cloud Messaging > Certificats Web Push > générer une paire de clés
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# Déjà présent sur Vercel pour /api/cleanup-listings — réutilisé tel quel pour
# /api/cron/session-reminders (aussi ajouté comme secret GitHub Actions, même valeur)
CRON_SECRET=

# SDK Admin Firebase (routes API serveur uniquement — cleanup-listings + notifications)
# Depuis le fichier JSON de compte de service téléchargé dans Firebase Console > Paramètres du projet > Comptes de service
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
